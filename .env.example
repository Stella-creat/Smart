# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会进仓库
# 所有项都有代码内默认值，不填也能在本地跑起来

# ---- 应用 ----
APP_NAME=智能知识库与个性化学习管理系统
DEBUG=true

# ---- 数据库 ----
# 开发用 SQLite（绝对路径，避免 cwd 不同导致找不到库）
DB_URL=sqlite:///D:/Smart/smart_dev.db
# 生产可换 MySQL：
# DB_URL=mysql+aiomysql://user:password@localhost:3306/smart?charset=utf8mb4

# ---- DeepTutor 引擎 ----
DEEPTUTOR_BASE_URL=http://localhost:8001
DEEPTUTOR_WS_URL=ws://localhost:8001/ws
DEEPTUTOR_TIMEOUT=15

# ---- JWT（上线前必须换成随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"）----
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- 映射适配层 ----
SEMANTIC_SIMILARITY_THRESHOLD_AUTO=0.85
SEMANTIC_SIMILARITY_THRESHOLD_REVIEW=0.60

# ---- 每日定时回流 ----
DAILY_ROLLOVER_ENABLED=false
DAILY_ROLLOVER_HOUR=0
DAILY_ROLLOVER_INTERVAL_SECONDS=300
